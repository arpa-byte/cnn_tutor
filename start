#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

port=8501
url="http://localhost:$port"

if [[ ! -x .venv/bin/streamlit ]]; then
    ./install
fi

if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
    echo "CNN Tutor is already running at $url"
    exit 0
fi

state_dir="$(mktemp -d "${TMPDIR:-/tmp}/cnn-tutor.XXXXXX")"
log_file="$state_dir/streamlit.log"

.venv/bin/streamlit run cnn_teaching_lab.py --server.headless true --server.port "$port" \
    --logger.level error >"$log_file" 2>&1 &
server_pid=$!

server_ready=0
for _ in {1..30}; do
    if curl --fail --silent --max-time 1 "$url" >/dev/null 2>&1; then
        server_ready=1
        break
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
        echo "CNN Tutor could not start. Check $log_file" >&2
        exit 1
    fi
    sleep 1
done

if (( ! server_ready )) || ! kill -0 "$server_pid" 2>/dev/null; then
    echo "CNN Tutor could not start. Check $log_file" >&2
    exit 1
fi

open "$url" >/dev/null 2>&1 || true
echo "CNN Tutor is running at $url"
echo "Close its browser tab to stop the dashboard."

(
    sleep 10
    disconnected_checks=0
    while kill -0 "$server_pid" 2>/dev/null; do
        if lsof -nP -iTCP:"$port" -sTCP:ESTABLISHED >/dev/null 2>&1; then
            disconnected_checks=0
        else
            disconnected_checks=$((disconnected_checks + 1))
        fi
        if (( disconnected_checks >= 3 )); then
            kill "$server_pid" 2>/dev/null || true
            exit 0
        fi
        sleep 5
    done
) >/dev/null 2>&1 &
